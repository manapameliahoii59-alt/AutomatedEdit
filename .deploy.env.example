# ==============================================================================
# AutomatedEdit 服务端一键部署配置文件
# 复制此文件为 .deploy.env 并填入实际密码后即可使用。
# 注意：.deploy.env 已被 .gitignore 忽略，绝对不会提交到 GitHub！
# ==============================================================================

# 腾讯云服务器公网 IP
DEPLOY_HOST=129.204.86.63

# SSH 端口（腾讯云/宝塔默认一般为 22，如在宝塔改过请填对应端口）
DEPLOY_PORT=22

# 登录用户名（Linux 管理员通常为 root）
DEPLOY_USER=root

# 服务器登录密码（留空时运行脚本会在控制台交互式提示输入）
DEPLOY_PASSWORD=

# 远程服务器项目根目录
DEPLOY_REMOTE_DIR=/www/wwwroot/automated-edit-api

# 重启命令（留空时会自动智能检测宝塔 Python 项目重启方式并执行）
# 若已知确切服务名，亦可显式指定，如：systemctl restart automated-edit-api
DEPLOY_RESTART_CMD=

# 部署完成后在线健康检查探活地址
DEPLOY_HEALTH_URL=http://129.204.86.63:7172/admin

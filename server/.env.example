# 复制为 .env 后填写（勿提交 .env）

# 本地连远程库（服务器已放行 3306 时）:
# DATABASE_URL=mysql+pymysql://用户名:密码@129.204.86.63:3306/automated_edit?charset=utf8mb4
# 本机 MySQL:
# DATABASE_URL=mysql+pymysql://用户名:密码@127.0.0.1:3306/automated_edit?charset=utf8mb4
DATABASE_URL=mysql+pymysql://automated_edit:你的密码@129.204.86.63:3306/automated_edit?charset=utf8mb4

# JWT 签名密钥（生产环境请用长随机字符串）
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# SQLAdmin 后台登录（与业务用户无关，仅管理页）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 易投第三方登录 API（桌面端登录时校验账号密码）
IOCPX_BASE_URL=https://api.iocpx.com


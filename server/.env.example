# 复制为 .env 后填写（勿提交 .env）

# 本地连远程库（服务器已放行 3306 时）:
# DATABASE_URL=mysql+pymysql://用户名:密码@129.204.86.63:3306/automated_edit?charset=utf8mb4
# 本机 MySQL:
# DATABASE_URL=mysql+pymysql://用户名:密码@127.0.0.1:3306/automated_edit?charset=utf8mb4
DATABASE_URL=mysql+pymysql://automated_edit:你的密码@129.204.86.63:3306/automated_edit?charset=utf8mb4

# JWT 签名密钥（生产环境请用长随机字符串）
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# SQLAdmin 后台登录（与业务用户无关，仅管理页）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 易投第三方登录 API（桌面端登录时校验账号密码）
IOCPX_BASE_URL=https://api.iocpx.com

# 策划服务（推荐在管理后台「用户」页按用户选择模型并填写 API Key）
# 以下为全局兜底 URL/模型；Keys 兜底仅在用户未配置时使用
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEYS=sk-global-fallback
OPENCODE_GO_API_URL=https://opencode.ai/zen/go/v1/chat/completions
OPENCODE_GO_MODEL=deepseek-v4-flash

# 桌面端更新：优先读 release/version.json（与打包输出同目录）
# 本地打包后把整个 release/ 上传到服务器 API 项目下，或指定：
# CLIENT_RELEASES_DIR=/www/wwwroot/automated-edit-api/release
# 若反代后拼出的下载地址不对：
# PUBLIC_BASE_URL=https://api.example.com

# 以下为回退配置（没有 version.json 时才用）
# CLIENT_LATEST_VERSION=0.0.1
# CLIENT_MIN_SUPPORTED_VERSION=0.0.1
# CLIENT_DOWNLOAD_URL=https://example.com/release/MyApp-v0.0.2-installer.exe
# CLIENT_CHANGELOG=修复若干问题；优化下载体验


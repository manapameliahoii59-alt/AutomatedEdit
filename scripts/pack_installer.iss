; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "剪辑助手"
#define MyAppVersion "0.0.23"
#define MyAppPublisher "dragon"
#define MyAppURL "mailto:857134647@qq.com"
#define MyAppExeName "entry.exe"
#define P "..\"

#ifndef CompressionLevel
  #define CompressionLevel "max"
#endif

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{8A7DBC8E-5877-472D-86C5-F3D1F2DF3785}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
; 默认安装目录由 [Code] 段的 GetDefaultDir 决定：
; 沿用用户自定义过的位置，但历史版本若装在临时目录（会被系统清理）则改回标准位置。
; 因此这里必须关掉 UsePreviousAppDir，否则 Inno 会强行覆盖成上次的路径。
DefaultDirName={code:GetDefaultDir}
DefaultGroupName={#MyAppName}
; Uncomment the following line to run in non administrative install mode (install for current user only.)
PrivilegesRequired=lowest
; LicenseFile="{#P}\resource\license.txt"
OutputDir="{#P}\release"
OutputBaseFilename="{#MyAppName}-v{#MyAppVersion}-installer"
SetupIconFile={#P}\resource\images\logo.ico
UninstallDisplayName=卸载 {#MyAppName}
UninstallDisplayIcon={#P}\resource\images\logo.ico
Compression=lzma2/{#CompressionLevel}
SolidCompression=yes
LZMAUseSeparateProcess=yes
LZMANumBlockThreads=6
WizardStyle=modern
; 升级时跳过目录选择页（默认路径由 GetDefaultDir 计算）
DisableDirPage=auto
; 必须为 no：历史版本若装在临时目录，需要改回标准位置，
; 开着的话 Inno 会无视 GetDefaultDir 强行沿用上次路径。
UsePreviousAppDir=no
; 安装/升级前尽量关闭占用文件的进程（配合下方 [Code] 强制结束）
CloseApplications=force
CloseApplicationsFilter=entry.exe,ffmpeg.exe,ffprobe.exe

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: checkablealone

[Files]
Source: "{#P}\out\entry.dist\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
; 排除 config.json 及 Python 字节码缓存：升级时保留用户本地配置，首次安装单独写入干净默认文件
Source: "{#P}\out\entry.dist\*"; DestDir: "{app}"; Excludes: "config.json,*.pyc,__pycache__"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#P}\out\entry.dist\config.json"; DestDir: "{app}"; Flags: onlyifdoesntexist

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{group}\卸载 {#MyAppName}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

; 运行期生成的文件（config/logs/changdu_data/crash.log 等）不在安装清单内，需显式清理
[UninstallDelete]
Type: filesandordirs; Name: "{app}\changdu_data"
Type: filesandordirs; Name: "{app}\logs"
Type: filesandordirs; Name: "{app}\__pycache__"
Type: files; Name: "{app}\config.json"
Type: files; Name: "{app}\crash.log"
Type: files; Name: "{app}\startup.log"
; 兜底：删除安装目录下剩余全部内容（含 Playwright 运行日志等）
Type: filesandordirs; Name: "{app}"

[Code]
{ 旧版本的安装位置：读卸载注册表项里的 InstallLocation。
  这里的 GUID 必须与 [Setup] 段 AppId 展开后的实际值保持一致
  （AppId 写的是双花括号开头，展开后就是下面这个带花括号的 GUID）。 }
function GetPreviousInstallDir(): String;
var
  PrevDir: String;
begin
  Result := '';
  PrevDir := '';
  if RegQueryStringValue(HKCU,
       'Software\Microsoft\Windows\CurrentVersion\Uninstall\{8A7DBC8E-5877-472D-86C5-F3D1F2DF3785}_is1',
       'InstallLocation', PrevDir) then
    Result := PrevDir
  else if RegQueryStringValue(HKLM,
       'Software\Microsoft\Windows\CurrentVersion\Uninstall\{8A7DBC8E-5877-472D-86C5-F3D1F2DF3785}_is1',
       'InstallLocation', PrevDir) then
    Result := PrevDir;

  { 去掉末尾反斜杠，便于拼接与比较 }
  if (Length(Result) > 3) and (Result[Length(Result)] = '\') then
    Delete(Result, Length(Result), 1);
end;

{ 路径是否落在临时目录下。临时目录会被磁盘清理/存储感知清空，
  装在这里的软件随时可能消失，不能沿用。 }
function IsUnderTempDir(const Dir: String): Boolean;
begin
  Result := (Dir <> '') and (Pos('\temp\', Lowercase(Dir)) > 0);
end;

{ DefaultDirName 的脚本常量实现：优先沿用用户自己选过的安装位置，
  但临时目录一律改回标准位置。 }
function GetDefaultDir(Param: String): String;
var
  PrevDir: String;
begin
  PrevDir := GetPreviousInstallDir();
  if (PrevDir <> '') and (not IsUnderTempDir(PrevDir)) and DirExists(PrevDir) then
    Result := PrevDir
  else
    Result := ExpandConstant('{autopf}\{#MyAppName}');
end;

function EscapeForPowerShellSingleQuoted(const S: String): String;
var
  I: Integer;
  Ch: Char;
begin
  Result := '';
  for I := 1 to Length(S) do
  begin
    Ch := S[I];
    if Ch = #39 then
      Result := Result + #39#39
    else
      Result := Result + Ch;
  end;
end;

procedure KillKnownExeNames;
var
  ResultCode: Integer;
begin
  { 注意：这里不能用 /T 结束进程树。
    安装程序通常由客户端通过 os.startfile 拉起，此时它是 entry.exe 的子进程，
    /T 会连同整棵进程树一起结束，把安装程序自己也杀掉，表现为「下载完没反应」。
    子进程（ffmpeg/ffprobe）由下面的按名结束和应用目录扫描负责清理。 }
  Exec('taskkill.exe', '/F /IM entry.exe', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  Exec('taskkill.exe', '/F /IM ffmpeg.exe /T', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  Exec('taskkill.exe', '/F /IM ffprobe.exe /T', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
end;

procedure KillProcessesUnderAppDir;
var
  ResultCode: Integer;
  AppDir, Escaped, Cmd: String;
begin
  AppDir := ExpandConstant('{app}');
  if AppDir = '' then
    Exit;
  { 去掉末尾反斜杠，便于 StartsWith 匹配 }
  if (Length(AppDir) > 3) and (AppDir[Length(AppDir)] = '\') then
    Delete(AppDir, Length(AppDir), 1);

  Escaped := EscapeForPowerShellSingleQuoted(AppDir);
  { 仅结束「可执行路径位于安装目录下」的进程，避免误杀用户自己的 Chrome }
  Cmd :=
    'Get-CimInstance Win32_Process | ' +
    'Where-Object { $_.ExecutablePath -and $_.ExecutablePath.StartsWith(''' + Escaped + ''', [StringComparison]::OrdinalIgnoreCase) } | ' +
    'ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }; ' +
    'Start-Sleep -Milliseconds 800';

  Exec(
    'powershell.exe',
    '-NoProfile -ExecutionPolicy Bypass -Command "' + Cmd + '"',
    '',
    SW_HIDE,
    ewWaitUntilTerminated,
    ResultCode
  );
end;

procedure CloseAppRelatedProcesses;
begin
  KillKnownExeNames;
  KillProcessesUnderAppDir;
  { 再杀一次主程序进程树，确保释放 DLL/日志等占用 }
  KillKnownExeNames;
end;

function InitializeSetup(): Boolean;
var
  PrevDir, NewDir, Msg: String;
  ResultCode: Integer;
begin
  { 安装目录尚未就绪，只能按进程名关闭 }
  KillKnownExeNames;

  { 历史版本若装在临时目录，先提示卸载，避免留下无法清理的残留 }
  PrevDir := GetPreviousInstallDir();
  if IsUnderTempDir(PrevDir) then
  begin
    NewDir := ExpandConstant('{autopf}\{#MyAppName}');
    Msg := '检测到旧版本安装在临时目录：' + #13#10 + PrevDir + #13#10#13#10 +
      '临时目录可能被系统清理，导致程序突然无法打开。建议先卸载旧版本，' +
      '本次将安装到正常位置：' + #13#10 + NewDir + #13#10#13#10 +
      '是否现在卸载旧版本？';
    if MsgBox(Msg, mbConfirmation, MB_YESNO) = IDYES then
    begin
      if FileExists(PrevDir + '\unins000.exe') then
        Exec(PrevDir + '\unins000.exe', '/SILENT /SUPPRESSMSGBOXES /NORESTART',
          '', SW_SHOW, ewWaitUntilTerminated, ResultCode)
      else
        MsgBox('未找到卸载程序，请手动删除该目录后重新安装：' + #13#10 + PrevDir,
          mbInformation, MB_OK);
    end;
  end;

  Result := True;
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
begin
  { 用户已确认安装目录后再按目录清理进程 }
  CloseAppRelatedProcesses;
  Result := '';
end;

function InitializeUninstall(): Boolean;
begin
  { 卸载前强制关闭，避免文件占用导致大量残留 }
  CloseAppRelatedProcesses;
  Result := True;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  AppDir: String;
begin
  if CurUninstallStep = usUninstall then
    CloseAppRelatedProcesses;
  { 卸载收尾再清一次安装目录，避免运行期新建文件残留 }
  if CurUninstallStep = usPostUninstall then
  begin
    CloseAppRelatedProcesses;
    AppDir := ExpandConstant('{app}');
    if (AppDir <> '') and DirExists(AppDir) then
      DelTree(AppDir, True, True, True);
  end;
end;
